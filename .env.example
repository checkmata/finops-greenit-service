# finops-greenit-service environment configuration
# Copy to .env and adjust values for your environment

# --- Prometheus / Metrics ---
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090
PROMETHEUS_QUERY_TIMEOUT_SECONDS=10

# --- Green IT Constants ---
# PUE (Power Usage Effectiveness) - total facility power / IT equipment power
# Typical: 1.1-1.3 (efficient), 1.4-1.6 (average), >2.0 (inefficient)
PUE_CONSTANT=1.4

# Grid carbon intensity in gCO2/kWh - location-specific
# Examples: France ~50, Germany ~380, US average ~380, Poland ~700
GRID_CARBON_INTENSITY_GCO2_PER_KWH=475.0

# --- Cost Model (USD) ---
COST_PER_VCPU_HOUR_USD=0.03
COST_PER_GB_HOUR_USD=0.004
COST_PER_GB_MONTH_USD=0.10

# --- API / Server ---
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Cache / Performance ---
METRICS_CACHE_TTL_SECONDS=60