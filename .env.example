# finops-greenit-service environment configuration
# Copy to .env and adjust values for your environment

# --- Prometheus / Metrics ---
PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090
PROMETHEUS_QUERY_TIMEOUT_SECONDS=10

# --- Green IT Constants ---
# PUE (Power Usage Effectiveness) - total facility power / IT equipment power
# Typical: 1.1-1.3 (efficient), 1.4-1.6 (average), >2.0 (inefficient)
PUE_CONSTANT=1.4

# Grid carbon intensity in gCO2/kWh - location-specific
# Examples: France ~50, Germany ~380, US average ~380, Poland ~700
GRID_CARBON_INTENSITY_GCO2_PER_KWH=475.0

# --- Cost Model (USD) ---
COST_PER_VCPU_HOUR_USD=0.03
COST_PER_GB_HOUR_USD=0.004
COST_PER_GB_MONTH_USD=0.10

# --- API / Server (single worker: the scheduler runs in-process) ---
API_HOST=0.0.0.0
API_PORT=8080

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Database (TimescaleDB) — DEV ONLY ---
# .env is git-ignored. Pick any local password; docker-compose reads it.
# Production: Kubernetes/OpenShift Secret or a secret manager, never a file in Git.
POSTGRES_PASSWORD=change-me-dev-only
DATABASE_URL=postgresql://finops:change-me-dev-only@localhost:5432/finops_greenit
GRAFANA_ADMIN_PASSWORD=change-me-dev-only

# --- Real clusters (V2) — Prometheus of each cluster, reachable from the api container
# (minikube/KVM: the VMs' addresses on the shared libvirt "default" network, NodePort 30090)
PROMETHEUS_PRIMARY_URL=http://192.168.122.242:30090
PROMETHEUS_SECONDARY_URL=http://192.168.122.50:30090

# --- Multicluster (V1) ---
# Unset = one cluster named CLUSTER_NAME via PROMETHEUS_URL.
CLUSTER_NAME=local
# CLUSTERS_CONFIG_FILE=config/clusters.local.yaml

# --- Scheduler (V1) ---
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300
# Comma-separated explicit list; empty = discover from Prometheus
SCHEDULER_NAMESPACES=
NAMESPACE_INCLUDE_REGEX=.*
NAMESPACE_EXCLUDE_REGEX=^(kube-.*|openshift.*|kepler)$
WORKLOAD_LABEL=app
# Hours of CPU history required before right-sizing (7 days = 168 advised in prod)
MIN_OBSERVATION_HOURS=24
# --- Failover (V2) ---
# decision_only | manual (human approves via POST /api/failover/events/{id}/approve) | auto
FAILOVER_MODE=manual
FAILOVER_FAILURE_THRESHOLD_SECONDS=60
FAILOVER_RECOVERY_THRESHOLD_SECONDS=120
FAILOVER_TICK_SECONDS=10
FAILOVER_NAMESPACES=banking,trading,ecommerce
FAILOVER_MAX_REPLICAS=5
# auto | postgres | none — leader election between API replicas (PostgreSQL advisory lock)
LEADER_ELECTION=auto
