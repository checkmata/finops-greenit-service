# --- Secrets & local config (NEVER commit) ---
.env
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS junk ---
.DS_Store
Thumbs.db

# --- Docker ---
*.log

# --- Local scratch / test data you generate while developing ---
scripts/output/
*.local.json

# local demo runtime (scripts/run_local_demo.sh)
.demo/

# V1: real Kubernetes secrets are never committed (use *.example.yaml as template)
manifests/secret.yaml
manifests/timescaledb-secret.yaml

# V2: runtime secrets (tokens, CAs) mounted as Docker secrets — never committed
.secrets/

# V2.x local GitOps working copy (published to the local Gitea only)
.gitops-work/

# Evidence of the REAL runs (DR, GitOps, agent E2E) is part of the documentation (secret-scanned)
!docs/evidence/*.log
