            "uid": "timescaledb"
          },
          "rawSql": "SELECT severity, cluster, namespace,\n  workload, category, resource, message, estimated_savings_usd AS savings_usd, estimation_method, updated_at\nFROM recommendations WHERE status = 'pending' AND cluster IN ($cluster) AND namespace IN ($namespace)\nORDER BY estimated_savings_usd DESC NULLS LAST, updated_at DESC LIMIT 200",
