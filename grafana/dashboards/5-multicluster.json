          },
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 38,
      "title": "Used cost by cluster (hourly aggregate)",
      "type": "timeseries",
      "description": "Continuous aggregate: primary vs secondary.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS time, cluster AS metric,\n  sum(cost_usd) AS value FROM metric_snapshots_hourly WHERE $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 39,
      "title": "Measured CO\u2082 by cluster (hourly aggregate, g)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS time,\n  cluster AS metric, sum(co2_kg) * 1000 AS value FROM metric_snapshots_hourly\nWHERE $__timeFilter(bucket) AND co2_kg IS NOT NULL GROUP BY 1, 2 ORDER BY 1",
