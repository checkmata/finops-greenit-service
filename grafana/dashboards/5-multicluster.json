    {
      "id": 37,
      "title": "Failover / failback events",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT at, kind, from_cluster, to_cluster, reason,\n  action_status, decided_by, action_detail::text AS detail FROM failover_events ORDER BY at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
