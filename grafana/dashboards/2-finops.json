    {
      "id": 17,
      "title": "Workloads \u2014 latest cost view",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT cluster, namespace, workload, team,\n  ROUND(cpu_cores_used::numeric, 3) AS cpu_used, cpu_cores_requested AS cpu_req,\n  ROUND(requested_cost_usd::numeric, 2) AS requested_usd, ROUND(actual_cost_usd::numeric, 2) AS used_usd,\n  ROUND(waste_cost_usd::numeric, 2) AS waste_usd, ROUND(potential_savings_usd::numeric, 2) AS savings_usd\nFROM (SELECT DISTINCT ON (cluster, namespace, workload) * FROM workload_snapshots\n      WHERE $__timeFilter(time) AND cluster IN ($cluster) AND namespace IN ($namespace)\n      ORDER BY cluster, namespace, workload, time DESC) w\nORDER BY waste_usd DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
