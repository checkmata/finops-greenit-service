          "rawSql": "SELECT cluster, namespace, storage_status, storage_cost_usd FROM (SELECT DISTINCT ON (cluster, namespace) * FROM metric_snapshots\n   WHERE $__timeFilter(time) AND cluster IN ($cluster) AND namespace IN ($namespace) ORDER BY cluster, namespace, time DESC) l ORDER BY 1, 2",
