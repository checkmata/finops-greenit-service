  "panels": [
    {
      "id": 9,
      "title": "Monthly cost \u2014 used resources",
      "type": "stat",
      "description": "Estimate: quantity \u00d7 configured price \u00d7 720 h. Not an invoice.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT SUM(cost_usd) FROM (SELECT DISTINCT ON (cluster, namespace) * FROM metric_snapshots\n   WHERE $__timeFilter(time) AND cluster IN ($cluster) AND namespace IN ($namespace) ORDER BY cluster, namespace, time DESC) l",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "custom": {},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {}
    },
