    "finops-greenit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT cluster FROM metric_snapshots ORDER BY 1",
        "definition": "SELECT DISTINCT cluster FROM metric_snapshots ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "allValue": null,
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT namespace FROM metric_snapshots WHERE cluster IN ($cluster) ORDER BY 1",
        "definition": "SELECT DISTINCT namespace FROM metric_snapshots WHERE cluster IN ($cluster) ORDER BY 1",
        "multi": true,
