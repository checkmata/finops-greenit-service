    {
      "id": 16,
      "title": "Storage status",
      "type": "table",
      "description": "'unavailable' = not priced (no kubelet stats) \u2014 it does NOT mean free.",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
