          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT bucket AS time, cluster || '/' || namespace AS metric, SUM(v) AS value FROM (\n  SELECT time_bucket('$__interval'::interval, time) AS bucket, cluster, namespace, AVG(waste_cost_usd) AS v\n  FROM metric_snapshots WHERE $__timeFilter(time) AND cluster IN ($cluster) AND namespace IN ($namespace) AND waste_cost_usd IS NOT NULL\n  GROUP BY 1, 2, 3) s\nGROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
